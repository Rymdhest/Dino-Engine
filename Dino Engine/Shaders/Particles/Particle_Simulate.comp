#version 430

// Moves every live particle on by a frame, and gets it ready to draw. One thread a slot, up to the highest live one:
// 1. It's carried by the air (the wind map, gusts and blasts included, and a curl field of swirls that rises with what's hot), drags towards its speed, rises if hot and falls if
//    heavy. What reaches the ground under where it was born bounces, sticks or is gone.
// 2. Its sort key is how far it is from the eye, so that ParticleSort can put the farthest first.
// 3. If it's lit, the light reaching it from each of six ways about its picture (the sky and ground, the sun through clouds and shadow, and every local light near the view) is
//    worked out once here rather than at every corner or pixel.
// Slots past the highest live one, up to the size the sort works on, are given keys that sort last.

layout(local_size_x = 256) in;

#include Globals.glsl
#include Wind.glsl
#include Weather/Weather.glsl
#include Weather/Sun_Visibility.glsl
#include Lighting/lightingCalc.glsl
#include Particles/Particle.glsl

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};
layout(std430, binding = 1) readonly buffer StyleBuffer {
    ParticleStyleData styles[];
};
layout(std430, binding = 2) writeonly buffer KeyBuffer {
    uvec2 keys[];
};
layout(std430, binding = 3) writeonly buffer LightingBuffer {
    uvec4 lighting[];
};

// Metres added to the distance of what lies on the ground, for sorting: further than anything can be.
const float GROUND_FIRST = 100000.0;

uniform int highWater;
uniform int sortCount;
uniform float deltaTime;
uniform float turbulencePhase;

uniform vec3 sunTowards;
uniform vec3 sunIrradiance;
uniform vec3 skyLight;
uniform vec3 groundLight;
uniform int lightCount;
uniform vec4 lightPositionRadius[32];
uniform vec4 lightColourFill[32];
uniform int cascadeCount;
uniform mat4 cascadeMatrices[5];
uniform sampler2DShadow cascadeMaps[5];

uniform sampler2D windMap;

// A field of swirls: the curl of three noises, so what it moves neither piles up nor drains away (Bridson, 2007). It rises over time, as eddies are carried up a plume.
vec3 particleCurl(vec3 q)
{
    vec3 rise = vec3(0.0, -turbulencePhase, 0.0);
    vec4 a = windNoised(q + rise, WIND_NOISE_PERIOD);
    vec4 b = windNoised(q + rise + vec3(31.4, 47.2, 11.3), WIND_NOISE_PERIOD);
    vec4 c = windNoised(q + rise + vec3(-19.1, 23.7, 61.9), WIND_NOISE_PERIOD);
    return vec3(c.z - b.w, a.w - c.y, b.y - a.z);
}

// How much sun gets through to here past what casts shadows, read from the finest cascade that has it over a patch a little wider than a texel, as smoke has no hard edge.
float particleSunShadow(vec3 position)
{
    for (int i = 0; i < cascadeCount; i++)
    {
        vec4 clip = cascadeMatrices[i] * vec4(position, 1.0);
        vec3 coord = clip.xyz / clip.w * 0.5 + 0.5;
        if (any(lessThan(coord, vec3(0.0))) || any(greaterThan(coord, vec3(1.0)))) continue;
        vec2 texel = 2.0 / vec2(textureSize(cascadeMaps[i], 0));
        float depth = coord.z - 0.0005;
        float lit = textureLod(cascadeMaps[i], vec3(coord.xy + vec2(-texel.x, -texel.y), depth), 0.0)
                  + textureLod(cascadeMaps[i], vec3(coord.xy + vec2(texel.x, -texel.y), depth), 0.0)
                  + textureLod(cascadeMaps[i], vec3(coord.xy + vec2(-texel.x, texel.y), depth), 0.0)
                  + textureLod(cascadeMaps[i], vec3(coord.xy + vec2(texel.x, texel.y), depth), 0.0);
        return lit * 0.25;
    }
    return 1.0;
}

// Light from one way, shared between the six by the squares of its parts in the frame, which add up to one (as Valve's ambient cube, and six-way lightmaps, do).
void particleAddLight(inout ParticleLighting l, ParticleFrame f, vec3 towards, vec3 radiance)
{
    vec3 local = vec3(dot(towards, f.right), dot(towards, f.up), dot(towards, f.normal));
    vec3 share = local * local;
    l.light[local.x >= 0.0 ? 0 : 1] += radiance * share.x;
    l.light[local.y >= 0.0 ? 2 : 3] += radiance * share.y;
    l.light[local.z >= 0.0 ? 4 : 5] += radiance * share.z;
}

ParticleLighting particleLight(Particle p, ParticleFrame f)
{
    ParticleLighting l;
    for (int k = 0; k < 6; k++) l.light[k] = vec3(0.0);
    // The sky and the ground, as the ambient pass has them, for the side the eye sees: from up here, mostly the sky. Smoke takes it through all six of its lightmaps at once,
    // which is what darkens its creases (Particle.frag).
    l.ambient = mix(groundLight, skyLight, f.normal.y * 0.5 + 0.5);
    l.sun = 0.0;

    if (dot(sunIrradiance, sunIrradiance) > 0.0)
    {
        l.sun = particleSunShadow(p.position) * weatherSunVisibility(p.position.xz);
        particleAddLight(l, f, sunTowards, sunIrradiance * (l.sun / LIGHT_PI));
    }

    for (int i = 0; i < lightCount; i++)
    {
        vec3 toLight = lightPositionRadius[i].xyz - p.position;
        float gap = length(toLight);
        float falloff = lightFalloff(gap, lightPositionRadius[i].w);
        if (falloff <= 0.0) continue;
        vec3 radiance = lightColourFill[i].rgb * falloff;
        particleAddLight(l, f, toLight / max(gap, 1e-4), radiance / LIGHT_PI);
        vec3 fill = radiance * (lightColourFill[i].a / LIGHT_PI);
        for (int k = 0; k < 6; k++) l.light[k] += fill;
    }
    return l;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(sortCount)) return;
    if (i >= uint(highWater))
    {
        keys[i] = uvec2(PARTICLE_DEAD_KEY, i);
        return;
    }

    Particle p = particles[i];
    if (!(p.life > 0.0) || p.age >= p.life)
    {
        keys[i] = uvec2(PARTICLE_DEAD_KEY, i);
        return;
    }

    uint styleIndex = p.style & PARTICLE_STYLE_MASK;
    ParticleStyleData s = styles[styleIndex];
    float dt = deltaTime;

    bool upright = int(s.look.y + 0.5) == FACING_UPRIGHT;
    if (dt > 0.0 && (p.style & PARTICLE_LANDED) == 0u)
    {
        if (s.motion.x > 0.0 || upright)
        {
            // Carried at the speed the wind's patterns go, which levels off, as WindField.PatternSpeed has it: a gale carries smoke further and leans flames over, but doesn't make them frantic.
            vec3 wind = sampleWindMap(windMap, p.position.xz).xyz;
            vec3 air = wind * (s.air.z / (1.0 + length(wind) / 12.0));
            if (s.air.x > 0.0) air += particleCurl(p.position * s.air.y) * s.air.x;
            p.velocity += (air - p.velocity) * (1.0 - exp(-s.motion.x * dt));
            // A flame leans with the air it's in, whether or not that carries it off.
            if (upright) p.axis = air;
        }
        float lift = s.motion.z * exp(-p.age * s.motion.w);
        p.velocity.y += (lift - s.motion.y) * dt;
        p.position += p.velocity * dt;
        p.spin *= exp(-s.air.w * dt);
        p.angle += p.spin * dt;

        int contact = int(s.contact.x + 0.5);
        if (contact != CONTACT_NONE && dot(p.ground.xyz, p.ground.xyz) > 0.5)
        {
            vec3 n = p.ground.xyz;
            float above = dot(n, p.position) - p.ground.w;
            if (above < 0.0)
            {
                if (contact == CONTACT_BOUNCE)
                {
                    p.position -= n * above;
                    float into = dot(p.velocity, n);
                    vec3 along = p.velocity - n * into;
                    p.velocity = along * s.contact.z - n * (min(into, 0.0) * s.contact.y);
                }
                else if (contact == CONTACT_STICK)
                {
                    p.position -= n * above;
                    p.velocity = vec3(0.0);
                    p.axis = n;
                    p.spin = p.age;
                    p.style |= PARTICLE_LANDED;
                }
                else
                {
                    p.life = -1.0;
                }
            }
        }
    }

    p.age += dt;
    particles[i] = p;
    if (!(p.life > 0.0) || p.age >= p.life)
    {
        keys[i] = uvec2(PARTICLE_DEAD_KEY, i);
        return;
    }

    // What lies on the ground is drawn before anything else, as everything else stands over the ground it covers: a flame over its coals, smoke over a scorch.
    float viewDepth = -(viewMatrix * vec4(p.position, 1.0)).z;
    bool lying = int(s.look.y + 0.5) == FACING_GROUND || (p.style & PARTICLE_LANDED) != 0u;
    keys[i] = uvec2(particleSortKey(-(viewDepth + (lying ? GROUND_FIRST : 0.0))), i);

    if (s.look.w > 0.5)
    {
        ParticleFrame f = particleFrame(p, int(s.look.y + 0.5), int(s.look.x + 0.5), p.size, s.draw.w, s.draw.y);
        uvec4 a, b, c;
        particlePackLighting(particleLight(p, f), a, b, c);
        lighting[i * 3u] = a;
        lighting[i * 3u + 1u] = b;
        lighting[i * 3u + 2u] = c;
    }
}
