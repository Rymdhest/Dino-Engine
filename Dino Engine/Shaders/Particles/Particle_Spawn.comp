#version 430

// Puts this frame's new particles into the slots the CPU chose for them (ParticlePool).

layout(local_size_x = 64) in;

#include Globals.glsl
#include Particles/Particle.glsl

layout(std430, binding = 0) writeonly buffer ParticleBuffer {
    Particle particles[];
};
layout(std430, binding = 4) readonly buffer SpawnBuffer {
    Particle spawns[];
};
layout(std430, binding = 5) readonly buffer SpawnSlotBuffer {
    uint spawnSlots[];
};

uniform int spawnCount;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(spawnCount)) return;
    particles[spawnSlots[i]] = spawns[i];
}
