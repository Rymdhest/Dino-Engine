#version 430

// One direction of the occlusion's denoise (Occlusion_Trace.comp, OCCLUSION.md): [1 2 2 2 1] across five pixels, which weighs each of the four
// places in a tile's row alike and so takes the trace's 4 x 4 pattern out exactly, run once across and once up. It doesn't reach over an edge: a
// sample two pixels off counts only as much as both steps to it are on one surface. A pixel boxed in by edges, a thin thing on its own, lets a little
// in from either side anyway (XeGTAO's leak), or its own pattern would stay in it.

#include Globals.glsl
#include Occlusion/Occlusion.glsl

layout(local_size_x = 8, local_size_y = 8) in;
layout(r16f, binding = 0) uniform writeonly image2D target;

uniform sampler2D source;
uniform sampler2D edges;
// (1, 0) across, (0, 1) up.
uniform ivec2 direction;
// 1 on the last pass, which leaves it between 0 and 1.
uniform int finish;

vec4 edgesAt(ivec2 pixel, ivec2 size)
{
    return occlusionUnpackEdges(texelFetch(edges, clamp(pixel, ivec2(0), size - 1), 0).r);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(source, 0);
    if (any(greaterThanEqual(pixel, size))) return;

    bool across = direction.x != 0;
    vec4 here = edgesAt(pixel, size);
    vec4 forward = edgesAt(pixel + direction, size);
    vec4 backward = edgesAt(pixel - direction, size);

    // Each step counts only as much as both its ends agree it's one surface: this pixel's right with its right neighbour's left, and so on. The
    // edges are (left, right, up, down).
    vec4 forward2 = edgesAt(pixel + 2 * direction, size);
    vec4 backward2 = edgesAt(pixel - 2 * direction, size);
    float stepForward = across ? here.y * forward.x : here.z * forward.w;
    float stepBackward = across ? here.x * backward.y : here.w * backward.z;
    float stepForward2 = stepForward * (across ? forward.y * forward2.x : forward.z * forward2.w);
    float stepBackward2 = stepBackward * (across ? backward.x * backward2.y : backward.w * backward2.z);

    // A pixel walled in on both sides of this direction lets a little through, so that it gets blurred at all.
    float leak = 0.25 * clamp(1.0 - (stepForward + stepBackward), 0.0, 1.0);
    stepForward = max(stepForward, leak);
    stepBackward = max(stepBackward, leak);

    float centre = texelFetch(source, pixel, 0).r;
    float sum = 2.0 * centre;
    float weight = 2.0;
    ivec2 last = size - 1;
    sum += 2.0 * stepForward * texelFetch(source, clamp(pixel + direction, ivec2(0), last), 0).r;
    sum += 2.0 * stepBackward * texelFetch(source, clamp(pixel - direction, ivec2(0), last), 0).r;
    sum += stepForward2 * texelFetch(source, clamp(pixel + 2 * direction, ivec2(0), last), 0).r;
    sum += stepBackward2 * texelFetch(source, clamp(pixel - 2 * direction, ivec2(0), last), 0).r;
    weight += 2.0 * (stepForward + stepBackward) + stepForward2 + stepBackward2;

    float result = sum / weight;
    if (finish != 0) result = clamp(result, 0.0, 1.0);
    imageStore(target, pixel, vec4(result));
}
