#version 430

// One level of the depth pyramid the rays walk: each texel holds the nearest depth of the four below it, so a ray can step over everything a whole tile lies behind in one go. Level 0 is
// the resolved depth itself. Each level is its own dispatch, reading the one before. A level of odd size takes in the row and column that would otherwise fall between two texels.

layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, binding = 0) uniform writeonly image2D target;

uniform sampler2D source;
uniform int sourceLevel;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (any(greaterThanEqual(texel, size))) return;

    if (sourceLevel < 0)
    {
        imageStore(target, texel, vec4(texelFetch(source, texel, 0).r));
        return;
    }

    ivec2 sourceSize = textureSize(source, sourceLevel);
    ivec2 corner = texel * 2;
    float nearest = 1.0;
    int extraX = (sourceSize.x & 1) != 0 && texel.x == size.x - 1 ? 1 : 0;
    int extraY = (sourceSize.y & 1) != 0 && texel.y == size.y - 1 ? 1 : 0;
    for (int y = 0; y <= 1 + extraY; y++)
    {
        for (int x = 0; x <= 1 + extraX; x++)
        {
            nearest = min(nearest, texelFetch(source, min(corner + ivec2(x, y), sourceSize - 1), sourceLevel).r);
        }
    }
    imageStore(target, texel, vec4(nearest));
}
