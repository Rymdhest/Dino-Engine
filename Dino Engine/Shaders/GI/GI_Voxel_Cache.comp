#version 430

// What each surface voxel can see of the sun and the sky, worked out once and kept, as neither moves: the sun stands where it is all
// day and the moon takes its place (NightfallSingleton), and nothing the voxels hold moves at all. The sun is four rays, a little
// apart for a soft edge; the sky is a handful of rays from each open face, spread as the light a face takes in is. It goes through
// the voxels the level's last layout listed as pending (GI_Voxel_Index.comp), a slice of the list a frame, so that a new world settles
// over a few frames, and a window moving as the hero walks spreads its new surfaces over a few more, rather than costing one long one.

#include GI/GI.glsl
#include GI/GI_Voxels.glsl

layout(local_size_x = 64) in;

layout(r32ui, binding = 1) uniform uimage3D voxInfo;
layout(std430, binding = 2) readonly buffer GiPool { uint giPool[]; };
layout(std430, binding = 0) readonly buffer GiCounts { uint giCounts[]; };
layout(std430, binding = 28) readonly buffer GiPending { uint giPending[]; };

uniform int level;
uniform int first;      // This frame's slice of the list.
uniform int budget;

const int SKY_RAYS = 8;
const float SKY_REACH = 48.0;
const float SUN_REACH = 220.0;

// A face's rays: a cosine-weighted spread over its half of the sky, turned a little for each voxel so neighbours don't all agree.
vec3 skyRay(int i, vec3 n, float turn)
{
    float u = (float(i) + 0.5) / float(SKY_RAYS);
    float phi = 2.39996323 * float(i) + turn;
    float sinTheta = sqrt(u);
    vec3 local = vec3(cos(phi) * sinTheta, sqrt(max(1.0 - u, 0.0)), sin(phi) * sinTheta);
    vec3 helper = abs(n.y) > 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(helper, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * local.x + n * local.y + bitangent * local.z);
}

void main()
{
    uint listed = uint(first) + gl_GlobalInvocationID.x;
    if (gl_GlobalInvocationID.x >= uint(budget) || listed >= giCounts[GI_COUNT_PENDING + level]) return;
    uint index = giPending[uint(level) * GI_POOL_CAPACITY + listed];
    uint e = (uint(level) * GI_POOL_CAPACITY + index) * GI_POOL_STRIDE;
    int voxelLevel;
    ivec3 voxel = giUnpackVoxel(giPool[e], voxelLevel);
    ivec3 t = giTexel(voxel, level);
    uint info = imageLoad(voxInfo, t).r;
    if ((info & GI_INFO_PENDING) == 0u) return;

    float size = giVoxel[level].x;
    vec3 centre = giVoxelCentre(voxel, level);
    uint faces = info & GI_INFO_FACES;
    uint hash = giHash3(voxel);

    // The sun, from off the side of the surface that faces it. A voxel none of whose open faces look towards it is in its own shade.
    uint sun = 0u;
    vec3 L = giSunDirection.xyz;
    bool facing = false;
    for (int f = 0; f < 6; f++)
    {
        if (((faces >> uint(f)) & 1u) != 0u && dot(GI_FACE_NORMAL[f], L) > 0.0) facing = true;
    }
    if (giSunDirection.w > 0.5 && facing)
    {
        vec3 helper = abs(L.y) > 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
        vec3 tangent = normalize(cross(helper, L));
        vec3 bitangent = cross(L, tangent);
        vec3 from = giSurfaceStart(centre, size, faces, L);
        for (int i = 0; i < 4; i++)
        {
            float a = 1.5708 * float(i) + giUnit(hash) * 6.2832;
            vec3 dir = normalize(L + (tangent * cos(a) + bitangent * sin(a)) * 0.012);
            if (!giTrace(from, dir, 0.0, SUN_REACH, level, 1).hit) sun++;
        }
    }
    uint sunBits = (sun * 15u + 2u) / 4u;

    uint skyBits = 0u;
    float turn = giUnit(giHash(hash)) * 6.2832;
    for (int f = 0; f < 6; f++)
    {
        if (((faces >> uint(f)) & 1u) == 0u) continue;
        vec3 n = giSurfaceNormal(faces, f);
        vec3 from = giSurfaceStart(centre, size, faces, n);
        int open = 0;
        for (int i = 0; i < SKY_RAYS; i++)
        {
            vec3 dir = skyRay(i, n, turn);
            if (!giTrace(from, dir, 0.0, SKY_REACH, level, 1).hit) open++;
        }
        uint quantised = uint(float(open) / float(SKY_RAYS) * 7.0 + 0.5);
        skyBits |= quantised << uint(GI_INFO_SKY_SHIFT + 3 * f);
    }

    uint kept = info & (GI_INFO_FACES | GI_INFO_SOLID | GI_INFO_TERRAIN);
    imageStore(voxInfo, t, uvec4(kept | (sunBits << GI_INFO_SUN_SHIFT) | skyBits));
}
