#version 430

// Writes down which lattice point each probe is at, in the order the scan numbered them.

#include GI/GI.glsl
#include GI/GI_Probe.glsl

layout(local_size_x = 256) in;

void main()
{
    int column = int(gl_GlobalInvocationID.x);
    if (column >= GI_COLUMN_START[GI_CASCADES]) return;
    uint mask = giColumnMask[column];
    if (mask == 0u) return;
    int c = 0;
    while (column >= GI_COLUMN_START[c + 1]) c++;
    int local = column - GI_COLUMN_START[c];
    ivec2 xz = giColumns[c].xy + ivec2(local % giColumns[c].z, local / giColumns[c].z);
    int base = giColumnBase[column];
    int next = int(giColumnOffset[column]) - int(giCounts[GI_COUNT_PROBE_START + c]);
    while (mask != 0u)
    {
        int k = findLSB(mask);
        mask &= mask - 1u;
        if (next < GI_PROBE_CAPACITY[c]) giProbeKey[GI_PROBE_BASE[c] + next] = giPackKey(c, ivec3(xz.x, base + k, xz.y));
        next++;
    }
}
