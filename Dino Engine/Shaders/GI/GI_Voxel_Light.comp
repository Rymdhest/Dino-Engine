#version 430

// Lights every surface voxel of a level, once a frame: the light that leaves each of its open faces, which is all a ray sees where it
// strikes (GI/GI_Radiance.glsl). Each face takes the sun, as much as reaches it through the clouds; the sky, as much of it as the face
// can see; every lamp and fire near it that it can see; and the light of the surfaces around it in the part of its sky they hide,
// which is how light goes on bouncing: a room lit through its window lights its own walls. Then its own glow.

#include Globals.glsl
#include GI/GI.glsl
#include GI/GI_Voxels.glsl
#include Weather/Weather.glsl
#include Weather/Sun_Visibility.glsl
#include Lighting/lightingCalc.glsl
#include gBufferUtil.glsl

layout(local_size_x = 64) in;

layout(rgba8, binding = 0) uniform readonly image3D voxColor;
layout(r32ui, binding = 1) uniform readonly uimage3D voxInfo;
layout(std430, binding = 2) buffer GiPool { uint giPool[]; };
layout(std430, binding = 0) readonly buffer GiCounts { uint giCounts[]; };
layout(std430, binding = 3) readonly buffer GiLights { vec4 giLights[]; };     // Three to a light: position and reach, colour and spot, way it points and cone.
layout(std430, binding = 4) readonly buffer GiSkyLight { vec4 giSkyLight[8]; };
layout(std430, binding = 24) buffer GiBrickSum { uint giBrickSum[]; };        // Four to a brick: red, green and blue in 1/64ths, and how many.

uniform sampler3D giBrickLight;     // Last frame's mean light leaving the surfaces of each brick, and in alpha whether it has any.
uniform int level;

const float LIGHT_STANDOFF = 0.5;   // Metres short of a light a ray stops, as whatever holds a flame would hide it from everything.

// The light of the surfaces around a point, last frame, between the bricks around it; a brick with no surface doesn't count.
vec3 around(vec3 world)
{
    float brick = giVoxel[level].x * 4.0;
    vec3 b = world / brick - 0.5;
    ivec3 low = ivec3(floor(b));
    vec3 f = b - vec3(low);
    ivec3 windowLow = giOrigin[level].xyz >> 2;
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int i = 0; i < 8; i++)
    {
        ivec3 corner = ivec3(i & 1, (i >> 1) & 1, i >> 2);
        ivec3 c = low + corner;
        ivec3 r = c - windowLow;
        if (any(lessThan(r, ivec3(0))) || any(greaterThanEqual(r, GI_BRICKS))) continue;
        vec3 w3 = mix(1.0 - f, f, vec3(corner));
        vec4 light = texelFetch(giBrickLight, giBrickTexel(c, level), 0);
        float w = w3.x * w3.y * w3.z * light.a;
        sum += light.rgb * w;
        total += w;
    }
    return total > 1e-4 ? sum / total : vec3(0.0);
}

// What the whole sky gives a surface facing a way, from what it gives the six faces (an ambient cube).
vec3 skyFacing(vec3 n)
{
    vec3 squared = n * n;
    return squared.x * giSkyLight[n.x >= 0.0 ? 0 : 1].rgb + squared.y * giSkyLight[n.y >= 0.0 ? 2 : 3].rgb + squared.z * giSkyLight[n.z >= 0.0 ? 4 : 5].rgb;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= giCounts[level]) return;
    uint e = (uint(level) * GI_POOL_CAPACITY + index) * GI_POOL_STRIDE;
    int voxelLevel;
    ivec3 voxel = giUnpackVoxel(giPool[e], voxelLevel);
    ivec3 t = giTexel(voxel, level);
    vec4 colour = imageLoad(voxColor, t);
    uint info = imageLoad(voxInfo, t).r;
    uint faces = info & GI_INFO_FACES;
    vec3 centre = giVoxelCentre(voxel, level);

    vec3 albedo = colour.rgb;
    vec3 emission = decodeEmission(albedo, colour.a) * giParams.x;
    vec3 sun = giSunRadiance.rgb * (giInfoSun(info) * giSunDirection.w * weatherSunVisibility(centre.xz));
    vec3 bounce = around(centre) * giParams.y;
    vec3 L = giSunDirection.xyz;

    vec3 lit[6] = vec3[](vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));
    int lights = int(giParams.w);
    for (int j = 0; j < lights; j++)
    {
        vec4 place = giLights[j * 3];
        vec3 toLight = place.xyz - centre;
        float distance_ = length(toLight);
        if (distance_ >= place.w) continue;
        vec3 dir = toLight / max(distance_, 1e-4);
        vec4 light = giLights[j * 3 + 1];
        vec4 spot = giLights[j * 3 + 2];
        float cone = spot.w > -1.5 ? smoothstep(spot.w, mix(spot.w, 1.0, 0.25), dot(-dir, spot.xyz)) : 1.0;
        vec3 radiance = light.rgb * (lightFalloff(distance_, place.w) * cone);
        if (dot(radiance, vec3(1.0)) < 1e-4) continue;

        bool facing = false;
        for (int f = 0; f < 6; f++)
        {
            if (((faces >> uint(f)) & 1u) != 0u && dot(GI_FACE_NORMAL[f], dir) > 0.0) facing = true;
        }
        if (!facing) continue;
        vec3 from = giSurfaceStart(centre, giVoxel[level].x, faces, dir);
        float reach = max(distance(from, place.xyz) - LIGHT_STANDOFF, 0.0);
        if (reach > giVoxel[level].x && giTrace(from, normalize(place.xyz - from), 0.0, reach, level, 1).hit) continue;
        for (int f = 0; f < 6; f++) lit[f] += radiance * max(dot(giSurfaceNormal(faces, f), dir), 0.0);
    }

    vec3 leaving = vec3(0.0);
    float open_ = 0.0;
    for (int f = 0; f < 6; f++)
    {
        if (((faces >> uint(f)) & 1u) == 0u)
        {
            giPool[e + 1u + uint(f)] = 0u;
            continue;
        }
        // Every open face lit as the surface it belongs to: the steps of a slope alike, the two sides of a thin wall apart.
        vec3 n = giSurfaceNormal(faces, f);
        float sky = giInfoSky(info, f);
        vec3 irradiance = sun * max(dot(n, L), 0.0) + skyFacing(n) * sky + lit[f] + GI_PI * bounce * (1.0 - sky);
        vec3 radiance = albedo / GI_PI * irradiance + emission;
        giPool[e + 1u + uint(f)] = giPackRadiance(radiance);
        leaving += radiance;
        open_ += 1.0;
    }

    // What this voxel gives off, into its brick's sum, for next frame's bounce (GI_Voxel_BrickLight.comp).
    if (open_ > 0.0)
    {
        ivec3 brick = giBrickTexel(voxel >> 2, level);
        uint b = uint((brick.z * GI_BRICKS.y * GI_LEVELS + brick.y) * GI_BRICKS.x + brick.x) * 4u;
        uvec3 add = uvec3(clamp(leaving / open_, vec3(0.0), vec3(500.0)) * 64.0 + 0.5);
        atomicAdd(giBrickSum[b + 0u], add.r);
        atomicAdd(giBrickSum[b + 1u], add.g);
        atomicAdd(giBrickSum[b + 2u], add.b);
        atomicAdd(giBrickSum[b + 3u], 1u);
    }
}
