#version 430

// How many surface voxels each brick of a level holds, for the scan that lays out the level's pool (GI_Voxel_Index.comp).

#include GI/GI.glsl

layout(local_size_x = 64) in;

layout(r32ui, binding = 1) uniform readonly uimage3D voxInfo;
layout(std430, binding = 15) buffer GiScanData { uint giScanData[]; };

uniform int level;

void main()
{
    uint b = gl_GlobalInvocationID.x;
    uint bricks = uint(GI_BRICKS.x * GI_BRICKS.y * GI_BRICKS.z);
    if (b >= bricks) return;
    ivec3 brick = ivec3(int(b) % GI_BRICKS.x, (int(b) / GI_BRICKS.x) % GI_BRICKS.y, int(b) / (GI_BRICKS.x * GI_BRICKS.y));
    ivec3 first = brick * 4 + ivec3(0, level * GI_DIM.y, 0);
    uint count = 0u;
    for (int i = 0; i < 64; i++)
    {
        uint info = imageLoad(voxInfo, first + ivec3(i & 3, (i >> 2) & 3, i >> 4)).r;
        if ((info & GI_INFO_SOLID) != 0u && (info & GI_INFO_FACES) != 0u) count++;
    }
    giScanData[b] = count;
}
