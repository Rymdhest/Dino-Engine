#version 430

// Settles a freshly built region: an object's voxel is solid with the chance of how much of it is filled, decided by a hash of where it
// is, so the same voxel comes out the same every time it's built. A solid voxel takes the object's colour, and its glow; the ground's
// voxels keep the ground's. The scratch in voxIndex is cleared for the pool's indices.

#include GI/GI.glsl

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba8, binding = 0) uniform image3D voxColor;
layout(r32ui, binding = 1) uniform uimage3D voxInfo;
layout(r32ui, binding = 2) uniform uimage3D voxIndex;
layout(r32ui, binding = 3) uniform readonly uimage3D scratchColour;
layout(r32ui, binding = 4) uniform readonly uimage3D scratchEmission;

uniform ivec3 regionMin;
uniform ivec3 regionSize;
uniform int level;

const float GI_FILL_SCALE = 256.0;

void main()
{
    ivec3 r = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(r, regionSize))) return;
    ivec3 voxel = regionMin + r;
    ivec3 t = giTexel(voxel, level);
    ivec3 s = giTexel(voxel, 0);

    uint info = imageLoad(voxInfo, t).r;
    float filled = float(imageLoad(voxIndex, t).r) / GI_FILL_SCALE;
    bool object = filled > 0.0 && giUnit(giHash3(voxel + ivec3(0, level * 104729, 0))) < filled;
    vec4 colour = imageLoad(voxColor, t);

    if (object)
    {
        vec4 mean = unpackUnorm4x8(imageLoad(scratchColour, s).r);
        if (mean.a > 0.0) colour.rgb = mean.rgb;
        colour.a = float(imageLoad(scratchEmission, s).r) / 255.0;
        info = GI_INFO_SOLID;
    }
    else if ((info & GI_INFO_SOLID) == 0u)
    {
        info = 0u;
        colour = vec4(0.0);
    }

    imageStore(voxColor, t, colour);
    imageStore(voxInfo, t, uvec4(info));
    imageStore(voxIndex, t, uvec4(0u));
}
