#version 430

// How many probes each column wants, for the scan that numbers them (GI_Scan.comp, which runs on giColumnOffset in place).

#include GI/GI.glsl
#include GI/GI_Probe.glsl

layout(local_size_x = 256) in;

void main()
{
    int column = int(gl_GlobalInvocationID.x);
    if (column >= GI_COLUMN_START[GI_CASCADES]) return;
    giColumnOffset[column] = uint(bitCount(giColumnMask[column]));
}
