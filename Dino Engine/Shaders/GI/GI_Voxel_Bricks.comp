#version 430

// The bit masks rays walk on (GI/GI_Voxels.glsl): a uvec2 to each brick of 4x4x4 voxels, a bit set for each solid one.

#include GI/GI.glsl

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(r32ui, binding = 1) uniform readonly uimage3D voxInfo;
layout(rg32ui, binding = 5) uniform writeonly uimage3D voxBricks;

uniform ivec3 regionMin;    // In voxels, a whole number of bricks.
uniform ivec3 regionSize;
uniform int level;

void main()
{
    ivec3 b = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(b, regionSize >> 2))) return;
    ivec3 brick = (regionMin >> 2) + b;
    uvec2 mask = uvec2(0u);
    for (int z = 0; z < 4; z++)
    {
        for (int y = 0; y < 4; y++)
        {
            for (int x = 0; x < 4; x++)
            {
                ivec3 voxel = brick * 4 + ivec3(x, y, z);
                if ((imageLoad(voxInfo, giTexel(voxel, level)).r & GI_INFO_SOLID) == 0u) continue;
                uint bit = uint(x + 4 * y + 16 * z);
                if (bit < 32u) mask.x |= 1u << bit;
                else mask.y |= 1u << (bit - 32u);
            }
        }
    }
    imageStore(voxBricks, giBrickTexel(brick, level), uvec4(mask, 0u, 0u));
}
