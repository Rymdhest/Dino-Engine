#version 430

// The mean light leaving the surfaces of each brick of a level, for the bounce of the next frame's lighting (GI_Voxel_Light.comp, which summed it
// as it lit each voxel). The alpha says whether the brick has any surface at all, so that empty air doesn't count as darkness. The sums
// are left empty for the next time the level is lit.

#include GI/GI.glsl

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba16f, binding = 6) uniform writeonly image3D brickLight;
layout(std430, binding = 24) buffer GiBrickSum { uint giBrickSum[]; };

uniform int level;

void main()
{
    ivec3 brick = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(brick, GI_BRICKS))) return;
    ivec3 texel = brick + ivec3(0, level * GI_BRICKS.y, 0);
    uint b = uint((texel.z * GI_BRICKS.y * GI_LEVELS + texel.y) * GI_BRICKS.x + texel.x) * 4u;
    uint count = giBrickSum[b + 3u];
    vec4 light = vec4(0.0);
    if (count > 0u) light = vec4(vec3(giBrickSum[b], giBrickSum[b + 1u], giBrickSum[b + 2u]) / (64.0 * float(count)), 1.0);
    imageStore(brickLight, texel, light);
    giBrickSum[b] = 0u;
    giBrickSum[b + 1u] = 0u;
    giBrickSum[b + 2u] = 0u;
    giBrickSum[b + 3u] = 0u;
}
