#version 430

// Empties a region of a level before it's built again: what's kept there now is a stretch of the world that has only just come into
// the window. The scratch images are a level's size and shared by all of them, as one region is built at a time.

#include GI/GI.glsl

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba8, binding = 0) uniform writeonly image3D voxColor;
layout(r32ui, binding = 1) uniform writeonly uimage3D voxInfo;
layout(r32ui, binding = 2) uniform writeonly uimage3D voxIndex;
layout(r32ui, binding = 3) uniform writeonly uimage3D scratchColour;
layout(r32ui, binding = 4) uniform writeonly uimage3D scratchEmission;

uniform ivec3 regionMin;
uniform ivec3 regionSize;
uniform int level;

void main()
{
    ivec3 r = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(r, regionSize))) return;
    ivec3 voxel = regionMin + r;
    ivec3 t = giTexel(voxel, level);
    imageStore(voxColor, t, vec4(0.0));
    imageStore(voxInfo, t, uvec4(0u));
    imageStore(voxIndex, t, uvec4(0u));
    ivec3 s = giTexel(voxel, 0);
    imageStore(scratchColour, s, uvec4(0u));
    imageStore(scratchEmission, s, uvec4(0u));
}
