#version 430

// Grows the grass for one view (the camera, or a light for its shadow), in the manner of Ghost of Tsushima. One thread
// per candidate blade on a jittered grid over each chunk:
// 1. Blades gather into Voronoi tufts that share their height, colour and lean. Where the ground grows little, whole tufts
//    go and those left stay healthy: sparse grass stands in bunches, it doesn't shrink into specks.
// 2. The field thins out with distance (keeping about as many blades per pixel as up close). Blades leave in a fixed order
//    and shrink away before they go, and the survivors widen to cover.
// 3. Blades outside the view are culled, before most of the work.
// 4. Survivors take their place in the field: its height swells and sinks, and it is combed one way and another. Some are
//    plumes or blooms instead of leaves.
// 5. They get their final curve, bent by the wind and trampling, and are appended to the near list (15 vertex blades) or
//    the far list (7 vertices) of an indirect draw. In the shadow pass everything goes to the far list.
// Nothing about single blades is stored between frames: a blade's random values come from its cell in world space.

layout(local_size_x = 64) in;

#include Globals.glsl
#include Wind.glsl
#include Grass/GrassField.glsl
#include Grass/GrassBlade.glsl
#include Weather/Weather.glsl
#include Weather/SurfaceMap.glsl

layout(std140, binding = 5) uniform ChunkDataBuffer {
    vec4 chunkData[1024];   // xy chunk origin (world xz), z chunk size, w height map layer
};

struct GrassDrawCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
};
layout(std430, binding = 0) buffer GrassDrawCommands {
    GrassDrawCommand drawCommands[2];   // 0 near list, 1 far list
};
layout(std430, binding = 1) writeonly buffer GrassNearBlades {
    GrassBlade nearBlades[];
};
layout(std430, binding = 2) writeonly buffer GrassFarBlades {
    GrassBlade farBlades[];
};

uniform sampler2DArray heightmaps;
uniform sampler2DArray grassMaps;
uniform sampler2DArray grassColourMaps;
uniform sampler2DArray grassBloomMaps;
uniform sampler2D bendMap;
uniform sampler2D windMap;
uniform sampler2D touchMap;

uniform vec4 frustumPlanes[6];
uniform int bladesPerAxis;
uniform int shadowPass;
uniform int nearCapacity;
uniform int farCapacity;
uniform float textureMapOffset;

const float TAU = 6.28318530718;
const float LONGEST_KIND = 1.3 * 1.3;   // How much longer than the field a tall tuft's plume can stand.
const float FIELD_RELIEF = 2.5;         // How much more the light makes of the field's swells than their true slope.
const float BEND_KNEE = 0.9;            // Radians past which a blade starts to resist bending further.
const float DROOP_HOLD = 0.25;          // Radians of its own lean a blade's droop keeps to, against a wind from the other side.
const float DROOP_SOFTNESS = 0.15;      // Radians of lean over which the droop swings across, when the wind does win.
const float FACE_HOLD = 0.25;           // How much a blade's face keeps to the way it grew, as the square of a lean in radians.
const float FLUTTER_KINDS = 4.0;        // Rates a quarter apart, so that every kind lands on a whole flutter at the wrap.
const float FURTHEST_PULL = 2.5;        // The furthest a blade's tuft can draw it, in tuft spacings: tufts sit one to a cell, and the search takes the nearest.
const float TOUCH_SCATTER = 0.55;       // Metres a tuft can feel what's walking through from off its true place, so that the edge of a wake is tufts and not a line.
const float TOUCH_ROOT = 0.75;          // How much of a push a blade takes from its root: a foot lays a blade over, where the wind only curls its top.
const float TOUCH_FLUTTER = 0.5;        // How much a tuft shivers as it's let go, for each radian a second it's moving.

vec4 readChunkMap(sampler2DArray map, vec2 uv, float layer)
{
    return textureLod(map, vec3(uv * (1.0 - textureMapOffset) + vec2(textureMapOffset * 0.5), layer), 0.0);
}

// The nearest tuft centre: centres sit one per cell of a grid, jittered within it.
void nearestTuft(vec2 xz, out vec2 centre, out uint seed)
{
    float spacing = max(grassClump.x, 0.05);
    ivec2 cell = ivec2(floor(xz / spacing));
    float best = 1e30;
    centre = xz;
    seed = 0u;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            ivec2 c = cell + ivec2(x, y);
            uint h = grassHash(c, 0x68e31da4u);
            vec2 p = (vec2(c) + 0.15 + 0.7 * vec2(h & 0xffffu, h >> 16u) * (1.0 / 65535.0)) * spacing;
            float d = dot(p - xz, p - xz);
            if (d < best)
            {
                best = d;
                centre = p;
                seed = h;
            }
        }
    }
}

// Fraction of the blades kept at a distance. Above 1 close by, so blades only start to go past the thinning start.
float keepFraction(float viewDistance)
{
    float start = max(grassField.z, 0.1);
    float keep = max(start * start / max(viewDistance * viewDistance, 1e-4), grassField.w);
    return keep * (1.0 - smoothstep(grassField.y * 0.8, grassField.y, viewDistance));
}

float wrapAngle(float a)
{
    return a - TAU * floor(a / TAU + 0.5);
}

// Unit direction leaning `lean` radians from vertical towards lean's direction on the xz plane.
vec3 leanDirection(vec2 lean, float maxAngle)
{
    float amount = length(lean);
    if (amount < 1e-5) return vec3(0.0, 1.0, 0.0);
    float angle = min(amount, maxAngle);
    vec2 horizontal = lean / amount * sin(angle);
    return vec3(horizontal.x, cos(angle), horizontal.y);
}

// Holds a lean to VEGETATION_MAX_TOTAL_BEND, gently: a hard stop would freeze the field wherever the wind pushes it there.
vec2 limitBend(vec2 bend)
{
    float amount = length(bend);
    if (amount <= BEND_KNEE) return bend;
    float room = VEGETATION_MAX_TOTAL_BEND - BEND_KNEE;
    return bend * ((BEND_KNEE + room * (1.0 - exp((BEND_KNEE - amount) / room))) / amount);
}

// A direction with its angle doubled, its length squared: as a line has no front or back, this is how lines are added up.
vec2 asLine(vec2 v)
{
    return vec2(v.x * v.x - v.y * v.y, 2.0 * v.x * v.y);
}

bool growBlade(int index, out GrassBladeData blade, out bool near)
{
    vec4 chunk = chunkData[gl_WorkGroupID.y];
    vec2 chunkOrigin = chunk.xy;
    float chunkSize = chunk.z;
    float layer = chunk.w;
    float spacing = chunkSize / float(bladesPerAxis);

    ivec2 cell = ivec2(round(chunkOrigin / spacing)) + ivec2(index % bladesPerAxis, index / bladesPerAxis);
    uint seed = grassHash(cell, 0x9e3779b9u);
    vec2 xz = (vec2(cell) + vec2(grassRandom(seed), grassRandom(seed))) * spacing;

    // --- Where grass grows ---
    vec4 grassCell = readChunkMap(grassMaps, clamp((xz - chunkOrigin) / chunkSize, 0.0, 1.0), layer);    // r cover, g height, b dryness
    float grassMap = grassCell.r;
    if (grassMap <= 0.02) return false;

    // --- A blade's place in the thinning, and whether it can stay by any reckoning: it can't end up nearer than this ---
    float rank = grassRandom(seed);
    float nearest = max(length(xz - viewPosWorld.xz) - grassClump.x * FURTHEST_PULL, 0.0);
    float mostKept = keepFraction(nearest);
    if (shadowPass == 1) mostKept *= clamp(grassLod.z, 0.05, 1.0) * (1.0 - smoothstep(grassLod.y * 0.8, grassLod.y, nearest));
    if (rank >= mostKept) return false;

    // --- Tuft ---
    vec2 tuftCentre;
    uint tuft;
    nearestTuft(xz, tuftCentre, tuft);
    vec2 fromCentre = xz - tuftCentre;
    float tuftDistance = length(fromCentre) / max(grassClump.x, 0.05);

    // The less the ground grows, the tighter a tuft draws together.
    xz = mix(xz, tuftCentre, mix(max(grassClump.y, 0.65), grassClump.y, smoothstep(0.1, 0.4, grassMap)));

    // --- Ground ---
    vec2 local = (xz - chunkOrigin) / chunkSize;
    vec2 inside = clamp(local, 0.0, 1.0);
    vec4 terrain = readChunkMap(heightmaps, inside, layer);
    vec3 groundNormal = vec3(terrain.x, sqrt(max(0.0, 1.0 - dot(terrain.xy, terrain.xy))), terrain.y);
    // A blade pulled over the chunk's edge continues along the slope there rather than reading the neighbour's maps.
    vec2 overshoot = (local - inside) * chunkSize;
    vec3 root = vec3(xz.x, terrain.w - dot(groundNormal.xz, overshoot) / max(groundNormal.y, 0.2), xz.y);
    float fertility = grassFertility(grassMap, groundNormal.y, terrain.z);
    if (fertility <= 0.0) return false;

    // --- Distance thinning: every blade has a fixed rank and leaves when the kept fraction drops below it ---
    float viewDistance = length(root - viewPosWorld);
    float keep = keepFraction(viewDistance);
    // The survivors widen to keep the field covered; fully for the extra thinning of shadow casters, whose shape no
    // one sees, partly for the view's thinning, so far blades still look like blades.
    float widen = mix(1.0, inversesqrt(clamp(keep, 0.04, 1.0)), 0.75);
    if (shadowPass == 1)
    {
        float shadowDensity = clamp(grassLod.z, 0.05, 1.0);
        keep *= shadowDensity * (1.0 - smoothstep(grassLod.y * 0.8, grassLod.y, viewDistance));
        widen /= shadowDensity;
    }
    if (rank >= keep) return false;
    float fade = clamp((keep - rank) / (0.3 * min(keep, 1.0)), 0.0, 1.0);

    // --- View culling, roughly: no blade reaches further from its root than the longest a blade can grow ---
    float longest = grassBlade.x * (1.0 + grassBlade.y) * (1.0 + grassClump.z) * (1.0 + grassRoll.x) * LONGEST_KIND;
    float widest = grassBlade.z * widen * 2.5 + grassPaint.w;
    for (int i = 0; i < 6; i++)
    {
        if (dot(frustumPlanes[i].xyz, root) + frustumPlanes[i].w < -(longest + widest)) return false;
    }

    // --- Does this tuft live here? The ground decides for the whole tuft, so that sparse grass stands in bunches ---
    uint tuftState = tuft;
    float tuftRoll = grassRandom(tuftState);
    float supported = clamp((fertility - 0.05) / 0.4, 0.0, 1.0);
    // Thin ground doesn't grow its tufts evenly, but in scattered colonies, and each tuft is a wiry handful of blades.
    float colonies = 0.25 + 1.5 * grassValueNoise(root.xz * (1.0 / 7.0) + 11.0);
    float alive = smoothstep(tuftRoll - 0.15, tuftRoll + 0.15, supported * mix(colonies, 1.15, smoothstep(0.45, 0.9, supported)));
    if (grassRandom(seed) >= alive * mix(0.4, 1.0, smoothstep(0.25, 0.7, supported))) return false;

    // --- Size ---
    float tuftHeight = 1.0 + (grassRandom(tuftState) * 2.0 - 1.0) * grassClump.z;
    float tuftShade = grassRandom(tuftState);
    float tuftHue = grassRandom(tuftState);
    float tuftTurn = grassRandom(tuftState);
    // Tufts come in sorts, gathering in patches of their own: tall sweeping ones, and low fine ones between them.
    float tuftSort = grassRandom(tuftState);
    float tallShare = 0.12 + 0.5 * smoothstep(0.35, 0.72, grassValueNoise(root.xz * (1.0 / 9.0) + 53.0));
    tuftHeight *= tuftSort < tallShare ? 1.3 : (tuftSort > 0.82 ? 0.62 : 1.0);
    tuftHeight *= mix(0.55 + 0.9 * tuftShade, 1.0, smoothstep(0.3, 0.8, supported));
    // Tufts dome up: blades in the middle stand taller than at the rim.
    float dome = 1.15 - 0.45 * clamp(tuftDistance, 0.0, 1.0);
    // How high the field stands here. The cover decides where tufts grow; only where it runs out are they smaller.
    float swell = grassSwell(root.xz);
    float canopy = grassBlade.x * grassCell.g * groundNormal.y * mix(0.6, 1.0, smoothstep(0.08, 0.5, fertility)) * (1.0 + grassRoll.x * swell);
    float bladeLength = canopy * tuftHeight * dome * (1.0 + (grassRandom(seed) * 2.0 - 1.0) * grassBlade.y) * fade * mix(0.6, 1.0, alive);

    // --- What grows here: most are leaves, some a plume or a bloom ---
    vec4 bloomCell = readChunkMap(grassBloomMaps, inside, layer);       // rgb flower colour, a share of blades in flower
    vec4 colourCell = readChunkMap(grassColourMaps, inside, layer);     // rgb blade colour, a share of tufts in seed
    float kindRoll = grassRandom(seed);
    float seedRoll = grassRandom(tuftState);
    int kind = GRASS_LEAF;
    if (kindRoll < bloomCell.a * grassGround.y) kind = GRASS_BLOOM;
    else if (seedRoll < colourCell.a * grassPlume.w && kindRoll > 0.72) kind = GRASS_PLUME;
    float width = grassBlade.z * (0.75 + 0.5 * grassRandom(seed)) * widen * mix(0.4, 1.0, fade);
    float headRandom = grassRandom(seed);
    float headSize = grassPaint.w * (0.55 + 0.9 * headRandom * headRandom) * sqrt(widen) * mix(0.4, 1.0, fade);
    if (kind == GRASS_PLUME)
    {
        // Seed heads stand clear of the leaves.
        bladeLength = max(bladeLength, canopy * fade) * 1.3;
    }
    else if (kind == GRASS_BLOOM)
    {
        bladeLength = max(canopy, 0.3) * (0.85 + 0.3 * grassRandom(seed)) * fade;
        width *= 0.7;
    }
    if (bladeLength < 0.04) return false;

    // --- View culling, now that the blade's own length is known ---
    float reach = bladeLength * 1.1 + widest;
    for (int i = 0; i < 6; i++)
    {
        if (dot(frustumPlanes[i].xyz, root) + frustumPlanes[i].w < -reach) return false;
    }

    // --- Shape ---
    // Blades lean their own way, partly out from their tuft's centre so tufts splay open, and then the way the field is
    // combed, so that the blades of a whole patch lie together.
    float ownAngle = grassRandom(seed) * TAU;
    float outAngle = dot(fromCentre, fromCentre) > 1e-8 ? atan(fromCentre.y, fromCentre.x) : ownAngle;
    float leanAngle = ownAngle + wrapAngle(outAngle - ownAngle) * grassClump.w;
    float combAngle = grassCombAngle(root.xz, windHeading.zw) + (tuftTurn - 0.5) * 1.0;
    // Out on their own, tufts have no neighbours to lie with, and fan open.
    leanAngle += wrapAngle(combAngle - leanAngle) * grassRoll.z * smoothstep(0.3, 0.8, supported) + (grassRandom(seed) - 0.5) * 0.7;
    vec2 leanDir = vec2(cos(leanAngle), sin(leanAngle));
    float tilt = max(grassShape.x + (grassRandom(seed) * 2.0 - 1.0) * grassShape.y, 0.0);
    // Long blades flop over further than short ones. Flowers hold their heads up, and seed heads nod.
    float droop = grassShape.z * (0.5 + grassRandom(seed)) * clamp(bladeLength / max(grassBlade.x * 0.5, 0.01), 0.3, 1.5);
    // Water weighs a blade down, and snow lays it over.
    vec4 weatherHere = weatherKind.w > 0.5 ? weatherSurfaceAt(root.xz) : vec4(0.0);
    droop *= 1.0 + 0.55 * weatherHere.x + 0.9 * weatherHere.z;
    if (kind == GRASS_BLOOM)
    {
        tilt *= 0.5;
        droop *= 0.15;
    }
    else if (kind == GRASS_PLUME)
    {
        tilt *= 0.6;
        droop *= 0.7;
    }

    // The patch's sway and trampling from the vegetation simulation. Stiffer tufts bend less, so a patch moving as one still
    // has depth to it, and no two tufts stand the same. Then the tuft's own flutter: its blades shiver together, a little out
    // of step, because that many blades each on their own beat fizz like static.
    float tuftStiffness = grassRandom(tuftState);
    float tuftFlutterPhase = grassRandom(tuftState);
    float tuftFlutterKind = floor(grassRandom(tuftState) * FLUTTER_KINDS);
    vec2 windBend = vegetationBend(bendMap, windMap, root.xz) * (grassWave.x * (0.8 + 0.4 * tuftStiffness));
    // What's walking through reaches a tuft as a whole: its blades go over together, at the tuft's own pace, some sooner and some further than their neighbours.
    vec2 scatter = (vec2(grassRandom(tuftState), grassRandom(tuftState)) - 0.5) * (2.0 * TOUCH_SCATTER);
    vec4 touch = vegetationTouch(touchMap, tuftCentre + scatter);
    vec2 pushed = (touch.xy + leanDir * touch.z) * (grassWave.x * (0.65 + 0.7 * tuftStiffness));
    vec2 bend = limitBend(windBend + pushed);
    vec2 flutterMid = vec2(0.0);
    vec2 flutterTip = vec2(0.0);
    vec4 windHere = sampleWindMap(windMap, root.xz);
    vec2 wind = windHere.xz;
    float speed = length(wind);
    float flutterRandom = grassRandom(seed);
    float flutterPhase = grassRandom(seed) * TAU;
    if (speed > 1e-3 && vegetationParams.z > 0.0 && vegetationParams.y > 0.0)
    {
        vec2 along = wind / speed;
        vec2 acrossWind = vec2(-along.y, along.x);
        // Most in the gusts, and least in the lulls.
        float amplitude = vegetationParams.z * (min(speed / vegetationParams.y, 1.5) * (0.4 + 1.2 * windHere.w) + touch.w * TOUCH_FLUTTER) * (0.7 + 0.6 * flutterRandom);
        float phase = (vegetationParams.w * (1.0 + 0.25 * tuftFlutterKind) + tuftFlutterPhase) * TAU + flutterPhase * 0.15;
        // The bob runs up the blade like a wave along a whip: the tip lags behind the middle, and traces a narrow ellipse. The
        // phase wraps at a whole number of flutters, so anything read from it has to go round a whole number of times too.
        float midPhase = phase - 0.9;
        float tipPhase = phase - 1.8;
        flutterMid = 0.5 * amplitude * (along * sin(midPhase) + acrossWind * 0.4 * sin(midPhase + 1.7));
        flutterTip = amplitude * (along * sin(tipPhase) + acrossWind * 0.4 * sin(tipPhase + 1.7));
    }

    // Lean (radians from vertical, towards +x / +z) at the root, middle and tip. The root stays stiffer than the tip.
    vec2 steadyLean = leanDir * tilt + bend;
    // A blade droops the way it leans, and a wind from the other side has to stand it up before it can lay it over the
    // other way: the droop passes through nothing. Taken straight from the lean it would snap across at the point where the
    // wind and the blade's own lean cancel out, and with the flutter passing over that point, again and again. The flutter
    // has no part in this for the same reason.
    vec2 droopPull = leanDir * (tilt + DROOP_HOLD) + bend;
    vec2 droopDir = droopPull * inversesqrt(dot(droopPull, droopPull) + DROOP_SOFTNESS * DROOP_SOFTNESS);
    vec2 tipLean = steadyLean + flutterTip + droopDir * droop;
    vec2 rootLean = leanDir * (tilt * 0.3) + windBend * 0.4 + pushed * TOUCH_ROOT;
    vec2 midLean = mix(rootLean, tipLean, 0.45) + flutterMid;

    // A curve whose direction sweeps from the root's lean through the middle's to the tip's: the tip is where that
    // sweep ends up (Simpson's rule), and the inner control points carry the end directions.
    vec3 d0 = leanDirection(rootLean, 1.2);
    vec3 dm = leanDirection(midLean, 1.6);
    vec3 d1 = leanDirection(tipLean, 2.0);
    vec3 p3 = bladeLength / 6.0 * (d0 + 4.0 * dm + d1);
    vec3 p1 = bladeLength / 3.0 * d0;
    vec3 p2 = p3 - bladeLength / 3.0 * d1;
    // Keep the blade's length however it bends (a cubic's length is close to the mean of its chord and its control polygon).
    float curveLength = 0.5 * (length(p3) + length(p1) + length(p2 - p1) + length(p3 - p2));
    float scale = bladeLength / max(curveLength, 1e-5);
    p1 *= scale;
    p2 *= scale;
    p3 *= scale;
    // The curve stays inside its control points' hull, so this keeps it out of the ground.
    p2.y = max(p2.y, 0.04 * bladeLength);
    p3.y = max(p3.y, 0.02 * bladeLength);

    // A blade bends over its flat side, so it faces the way it leans: in a strong wind the whole field turns to face it.
    // Which of its faces doesn't matter, so this is a line. The way it grew holds that line as its lean passes through
    // upright, where the direction of a lean jumps right round. A little random twist keeps rows of blades from lining up.
    vec2 faceLine = asLine(leanDir) * FACE_HOLD + asLine(steadyLean);
    float faceAngle = 0.5 * atan(faceLine.y, faceLine.x);
    vec2 faceDir = dot(faceLine, faceLine) > 1e-10 ? vec2(cos(faceAngle), sin(faceAngle)) : leanDir;
    float twist = (grassRandom(seed) - 0.5) * 0.8;
    vec2 side = vec2(-faceDir.y, faceDir.x);
    side = vec2(side.x * cos(twist) - side.y * sin(twist), side.x * sin(twist) + side.y * cos(twist));

    blade.root = root;
    blade.width = width;
    blade.p1 = p1;
    blade.p2 = p2;
    blade.p3 = p3;
    blade.morph = smoothstep(grassLod.x * 0.7, grassLod.x, viewDistance);
    blade.side = side;
    blade.kind = kind;
    blade.headSize = headSize;
    blade.colour = vec3(0.0);
    blade.tipColour = vec3(0.0);
    blade.tipBleach = 0.0;
    blade.groundNormal = vec2(0.0);
    blade.rootAO = 1.0;
    blade.gloss = 0.0;
    blade.canopy = 1.0;
    blade.sheen = 0.0;
    blade.fieldNormal = vec2(0.0);
    blade.headColour = vec3(0.0);

    // --- Look. A shadow has none ---
    if (shadowPass == 0)
    {
        float dryness = grassDryness(root.xz, fertility, grassCell.b);
        float variation = grassRootColour.w;
        // The tops of the swells stand in the light, and their hollows hold the shade.
        vec3 body = grassPainted(colourCell.rgb, root.xz) * (1.0 + grassRoll.x * 0.8 * swell);
        vec3 colour = body * (1.0 + variation * ((tuftShade - 0.5) * 0.7 + (grassRandom(seed) - 0.5) * 0.35));
        // Each tuft is its own green, some leaning cool and some warm.
        colour *= mix(vec3(1.0), mix(vec3(0.7, 0.95, 1.15), vec3(1.36, 1.08, 0.66), tuftHue), variation);
        colour = mix(colour, grassDryColour.rgb, dryness * (0.75 + 0.25 * grassRandom(seed)));
        // Wet grass goes deep and rich, a good way darker than it was, and the straw most of all.
        colour *= mix(1.0, 0.62 - 0.14 * dryness, weatherHere.x);

        blade.colour = clamp(colour, 0.0, 1.0);
        blade.tipColour = clamp(grassTipOf(colour), 0.0, 1.0);
        // Snow lies on the top of a field, and that's what's seen of it.
        blade.tipColour = mix(blade.tipColour, vec3(0.86, 0.88, 0.92), weatherHere.z * 0.9);
        blade.tipBleach = clamp(0.35 + 0.5 * grassRandom(seed) + 0.3 * dryness, 0.0, 1.0);
        blade.groundNormal = groundNormal.xz;
        // Roots in thick grass, and in the middle of tufts, see less sky.
        blade.rootAO = clamp(mix(0.7, 0.2, clamp(fertility * 1.2, 0.0, 1.0)) - 0.1 * (1.0 - clamp(tuftDistance * 1.5, 0.0, 1.0)), 0.08, 1.0);
        // Every blade carries beads of water, and shines with them.
        blade.gloss = mix(grassRandom(seed), 1.0, weatherHere.x * 0.85);
        // Grass pressed down lies on top of the field, in the light, not deep inside it.
        blade.canopy = max(canopy, 0.1) * (1.0 - 0.7 * min(length(bend) * (1.0 / VEGETATION_MAX_TOTAL_BEND), 1.0));
        blade.sheen = grassWave.w * clamp(windCrest(root.xz) * 0.8 + smoothstep(0.5, 0.9, windHere.w) * 0.6, 0.0, 1.0);

        // The field's top as one soft surface: the ground's slope, the swells on it, and the nap of the blades, which
        // shows more of their flat sides to the sky the further they lie over.
        const float STEP = 0.7;
        vec2 rise = vec2(grassSwell(root.xz + vec2(STEP, 0.0)), grassSwell(root.xz + vec2(0.0, STEP))) - swell;
        vec2 slope = rise * (grassRoll.x * canopy * FIELD_RELIEF / STEP);
        // Without the flutter: the light on the field moves with its masses, and doesn't sparkle with each blade.
        vec2 napLean = steadyLean + droopDir * droop;
        vec3 fieldNormal = normalize(vec3(groundNormal.x - slope.x, groundNormal.y, groundNormal.z - slope.y) - vec3(napLean.x, 0.0, napLean.y) * 0.4);
        blade.fieldNormal = fieldNormal.xz;

        vec3 head = kind == GRASS_PLUME
            ? mix(grassPlume.rgb, blade.tipColour, 0.25) * (0.85 + 0.3 * tuftShade)
            : bloomCell.rgb * (0.82 + 0.36 * tuftHue);
        blade.headColour = clamp(head, 0.0, 1.0);
    }

    near = shadowPass == 0 && viewDistance < grassLod.x;
    return true;
}

// The two lists' counters are the one thing every blade in the field writes to. A group adds up what it grew and takes its places in one go, as
// a thread each would have them all queueing on one address.
shared uint groupNear;
shared uint groupFar;
shared uint firstNear;
shared uint firstFar;

// Takes `count` places in a list, and puts back any past its end, so that the draw never reads past the buffer. What doesn't fit is dropped.
uint takePlaces(int list, uint count, uint capacity)
{
    uint first = atomicAdd(drawCommands[list].instanceCount, count);
    uint end = first + count;
    if (end > capacity) atomicAdd(drawCommands[list].instanceCount, 0u - (end - max(first, capacity)));
    return first;
}

void main()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        groupNear = 0u;
        groupFar = 0u;
    }
    barrier();

    int index = int(gl_GlobalInvocationID.x);
    GrassBladeData blade;
    bool near = false;
    bool grown = index < bladesPerAxis * bladesPerAxis && growBlade(index, blade, near);
    uint place = 0u;
    if (grown) place = near ? atomicAdd(groupNear, 1u) : atomicAdd(groupFar, 1u);
    barrier();

    if (gl_LocalInvocationIndex == 0u)
    {
        if (groupNear > 0u) firstNear = takePlaces(0, groupNear, uint(nearCapacity));
        if (groupFar > 0u) firstFar = takePlaces(1, groupFar, uint(farCapacity));
    }
    barrier();

    if (!grown) return;
    if (near)
    {
        uint slot = firstNear + place;
        if (slot < uint(nearCapacity)) nearBlades[slot] = packGrassBlade(blade);
    }
    else
    {
        uint slot = firstFar + place;
        if (slot < uint(farCapacity)) farBlades[slot] = packGrassBlade(blade);
    }
}
