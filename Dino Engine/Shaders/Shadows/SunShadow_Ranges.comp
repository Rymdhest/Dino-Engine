#version 430

// The nearest and farthest depth in each block of 16 x 16 texels of a sun's shadow map (DirectionalLightRenderer.PrepareRanges), which the soft
// shadow reads to know, a few reads to a pixel, what can reach a point from how high, and when nothing does or everything does (Lighting/SunShadow.glsl,
// SHADOWS.md). A group is a block, each of its threads a gather of four texels; past the map's edge is its far end.

layout(local_size_x = 8, local_size_y = 8) in;
layout(rg32f, binding = 0) uniform writeonly image2D ranges;

uniform sampler2D shadowMap;

shared vec2 scratch[64];

void main()
{
    ivec2 block = ivec2(gl_WorkGroupID.xy);
    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    vec2 size = vec2(textureSize(shadowMap, 0));

    // The four texels from here to one up and across.
    ivec2 texel = block * 16 + local * 2;
    vec4 depth = textureGather(shadowMap, (vec2(texel) + 1.0) / size);
    int index = local.y * 8 + local.x;
    scratch[index] = vec2(min(min(depth.x, depth.y), min(depth.z, depth.w)), max(max(depth.x, depth.y), max(depth.z, depth.w)));
    barrier();

    for (int stride = 32; stride > 0; stride >>= 1)
    {
        if (index < stride)
        {
            vec2 other = scratch[index + stride];
            scratch[index] = vec2(min(scratch[index].x, other.x), max(scratch[index].y, other.y));
        }
        barrier();
    }

    if (index == 0) imageStore(ranges, block, vec4(scratch[0], 0.0, 0.0));
}
