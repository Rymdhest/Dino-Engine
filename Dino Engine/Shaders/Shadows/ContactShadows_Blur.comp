#version 430

// The contact shadows smoothed over the three by three pixels round each that are on one surface with it (ContactShadowRenderer, SHADOWS.md): a
// ray a pixel decides a shadow a pixel at a time, which crawls along its edges as the camera moves and leaves a pixel here and there that the depth's
// own steps shaded. [1 2 1] each way, each neighbour by how near its depth is to this one's, so nothing runs from a body onto the ground behind it.

#include Globals.glsl
#include Occlusion/Occlusion.glsl

layout(local_size_x = 8, local_size_y = 8) in;
layout(r8, binding = 0) uniform writeonly image2D target;

uniform sampler2D source;
uniform sampler2D linearDepth;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(source, 0);
    if (any(greaterThanEqual(pixel, size))) return;

    float distance = occlusionDistance(texelFetch(linearDepth, pixel, 0).r);
    if (distance >= OCCLUSION_SKY * 0.5)
    {
        imageStore(target, pixel, vec4(1.0));
        return;
    }

    // One surface: within two percent of the depth, and five centimetres more for what's close.
    float tolerance = 0.02 * distance + 0.05;
    float sum = 0.0;
    float total = 0.0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            ivec2 at = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            float apart = abs(occlusionDistance(texelFetch(linearDepth, at, 0).r) - distance);
            float weight = (x == 0 ? 2.0 : 1.0) * (y == 0 ? 2.0 : 1.0) * clamp(1.0 - apart / tolerance, 0.0, 1.0);
            sum += weight * texelFetch(source, at, 0).r;
            total += weight;
        }
    }
    imageStore(target, pixel, vec4(sum / total));
}
